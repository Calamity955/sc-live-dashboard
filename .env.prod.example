# ============================================================
# SC Live Dashboard — production environment template
# Copy to .env.prod and fill in your values.
# ============================================================

# --- Data source ---
# Values: local | sftp
DATA_SOURCE=local
DATA_PATH=./data/csv

# --- SFTP (fill when IT provides credentials) ---
# SFTP_HOST=10.x.x.x
# SFTP_PORT=22
# SFTP_USER=sc_dashboard
# SFTP_PASSWORD=
# SFTP_KEY_PATH=                  # alternative to SFTP_PASSWORD
# SFTP_PATH=/consegne_oggi.csv    # single-file mode
# SFTP_MODE=single                # single | newest
# SFTP_PATTERN=*.csv*             # only for mode=newest
# SFTP_KNOWN_HOSTS=               # empty = no host verification (LAN)

# --- Poller ---
# 120s = 2 minutes, aligned with IT export frequency
POLL_INTERVAL=120

# --- Filters ---
# 1 = drop rows with delivery date != today (Europe/Rome)
FILTER_TODAY=1

# --- Storage ---
DB_PATH=/app/data/sc.db

# --- HTTP ---
HOST=0.0.0.0
PORT=8765
